# Шаблон конфигурации AmneziaWG Easy.
# Скопируйте в .env и заполните под свой сервер:
#   cp .env.example .env
# Сам .env в git не попадает — он перечислен в .gitignore.

# Порт для VPN-подключений (UDP)
WG_PORT=51820

# Порт для веб-интерфейса (TCP)
PORT=51821

# Публичный IP или домен вашего сервера (ОБЯЗАТЕЛЬНО!)
# Клиенты получают это значение в своих конфигах. Должен резолвиться в адрес сервера
# через публичный DNS.
WG_HOST=example.com

# Пароль для входа в веб-интерфейс (ОБЯЗАТЕЛЬНО!)
# Это bcrypt-хеш, а не сам пароль. Сгенерировать:
#   docker run --rm httpd:2.4-alpine htpasswd -nbBC 12 "" 'НОВЫЙ_ПАРОЛЬ' | tr -d ':\n'
# Если значение пустое, админка вообще не спросит пароль.
PASSWORD_HASH='$2y$12$ЗАМЕНИТЕ_НА_СВОЙ_ХЕШ'

# Язык веб-интерфейса: en, ru, de, fr, es, it, pl, uk, tr и другие
LANG=ru

# Включить встроенный экспорт метрик Prometheus на порту PORT (/metrics, /metrics/json)
# Метрики содержат имена клиентов и их адреса. Если оставляете включённым и порт
# доступен из интернета — задайте PROMETHEUS_METRICS_PASSWORD ниже.
ENABLE_PROMETHEUS_METRICS=true

# Пароль для метрик (bcrypt). Пока не задан, /metrics отдаётся без аутентификации.
#PROMETHEUS_METRICS_PASSWORD='$2y$12$ТОТ_ЖЕ_ХЕШ'

# Параметры обфускации AmneziaWG (обход DPI).
#
# ВНИМАНИЕ: имена без префикса WG_. Приложение читает именно JC/JMIN/...,
# варианты WG_JC/WG_JMIN/... игнорируются и молча не применяются.
#
# Задаются только ДО первого запуска. При первом старте из этих значений создаётся
# wg0.json в томе etc_amnezia_wg; дальше конфиг читается оттуда, а переменные
# окружения на параметры обфускации больше не влияют.
#
# Значения ниже — рабочий пример. Для своего стенда сгенерируйте S3, S4, H1-H4 и
# I1-I5 так, чтобы не смешивать явные и случайные параметры: приложение при отсутствии
# значения подставляет случайное, и такое смешение само может стать признаком.

# Число junk-пакетов перед началом сессии
JC=6
# Минимальный размер junk-пакета, байт
JMIN=10
# Максимальный размер junk-пакета, байт
JMAX=30
# Размер junk в init-пакете, байт
S1=70
# Размер junk в response-пакете, байт
S2=110
# Padding cookie-reply (AmneziaWG 2.0), байт. Допустимо 15..149
S3=134
# Padding транспортных пакетов (AmneziaWG 2.0), байт. Допустимо 15..149
S4=110

# Магические заголовки пакетов (uint32)
H1=1943259813
H2=1843346077
H3=282040757
H4=2083881407

# Шаблоны пакетов с кастомной сигнатурой.
# Допустимые теги: <b 0x...>, <r N>, <rd N>, <rc N>, <t>.
# Для простого <r N> число должно быть в диапазоне 32..999.
I1='<r 969>'
I2='<r 213>'
I3='<r 415>'
I4='<r 481>'
I5='<r 114>'

# Дополнительно доступно (значения по умолчанию):
# Интерфейс для NAT. Укажите тот, через который уходит трафик на WG_HOST.
#WG_DEVICE=eth0
# DNS, который получат клиенты
#WG_DEFAULT_DNS=1.1.1.1
# Адресация клиентов
#WG_DEFAULT_ADDRESS=10.8.0.x
# Что клиентам разрешено маршрутизировать
#WG_ALLOWED_IPS=0.0.0.0/0, ::/0
# Детальная статистика трафика в UI
#UI_TRAFFIC_STATS=false
# Срок действия клиентов
#WG_ENABLE_EXPIRES_TIME=false
# Одноразовые ссылки на скачивание конфига
#WG_ENABLE_ONE_TIME_LINKS=false
# Время жизни сессии админки, минут. 0 — до закрытия браузера
#MAX_AGE=0
# Свои правила firewall вместо дефолтных (по умолчанию клиенты не видят LAN хоста)
#WG_POST_UP=
#WG_POST_DOWN=
